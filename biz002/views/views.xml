<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- データモデル：リスト & フォーム -->
    <!-- ========================================================= -->
    <record id="view_biz002_data_model_list" model="ir.ui.view">
        <field name="name">biz002.data_model.list</field>
        <field name="model">biz002.data_model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_biz002_data_model_form" model="ir.ui.view">
        <field name="name">biz002.data_model.form</field>
        <field name="model">biz002.data_model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>

                    <notebook>
                        <page string="データ項目">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="required"/>
                                    <field name="domain_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_biz002_data_model" model="ir.actions.act_window">
        <field name="name">データモデル</field>
        <field name="res_model">biz002.data_model</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================================================= -->
    <!-- データ項目：リスト & フォーム -->
    <!-- ========================================================= -->
    <record id="view_biz002_data_item_list" model="ir.ui.view">
        <field name="name">biz002.data_item.list</field>
        <field name="model">biz002.data_item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="required"/>
                <field name="model_id"/>
                <field name="domain_id"/>
            </list>
        </field>
    </record>

    <record id="view_biz002_data_item_form" model="ir.ui.view">
        <field name="name">biz002.data_item.form</field>
        <field name="model">biz002.data_item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="required"/>
                        <field name="model_id"/>
                        <field name="domain_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_biz002_data_item" model="ir.actions.act_window">
        <field name="name">データ項目</field>
        <field name="res_model">biz002.data_item</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================================================= -->
    <!-- データドメイン：リスト & フォーム -->
    <!-- ========================================================= -->
    <record id="view_biz002_data_domain_list" model="ir.ui.view">
        <field name="name">biz002.data_domain.list</field>
        <field name="model">biz002.data_domain</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="data_type"/>
                <field name="relation_model_id"/>
            </list>
        </field>
    </record>

    <record id="view_biz002_data_domain_form" model="ir.ui.view">
        <field name="name">biz002.data_domain.form</field>
        <field name="model">biz002.data_domain</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="data_type"/>
                        <field name="relation_model_id"/>
                    </group>

                    <notebook>
                        <page string="関連データ項目">
                            <field name="item_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="required"/>
                                    <field name="model_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_biz002_data_domain" model="ir.actions.act_window">
        <field name="name">データドメイン</field>
        <field name="res_model">biz002.data_domain</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- ========================================================= -->
    <!-- メニュー -->
    <!-- ========================================================= -->
    <menuitem id="menu_biz002_root" name="biz002 管理"/>

    <menuitem id="menu_biz002_model" name="データモデル"
              parent="menu_biz002_root"
              action="action_biz002_data_model"/>

    <menuitem id="menu_biz002_item" name="データ項目"
              parent="menu_biz002_root"
              action="action_biz002_data_item"/>

    <menuitem id="menu_biz002_domain" name="データドメイン"
              parent="menu_biz002_root"
              action="action_biz002_data_domain"/>

</odoo>
