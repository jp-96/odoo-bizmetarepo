<odoo>

    <!-- ========================= -->
    <!-- 概念モデル（Conceptual Model） -->
    <!-- ========================= -->

    <record id="entity_attribute" model="ems.cdm.entity">
        <field name="name">属性</field>
        <field name="subject_area_id" ref="subject_area_conceptual"/>
    </record>

    <record id="entity_conceptual_entity" model="ems.cdm.entity">
        <field name="name">エンティティ</field>
        <field name="subject_area_id" ref="subject_area_conceptual"/>
    </record>

    <record id="entity_subject_area" model="ems.cdm.entity">
        <field name="name">サブジェクト領域</field>
        <field name="subject_area_id" ref="subject_area_conceptual"/>
    </record>

    <record id="entity_attribute_domain" model="ems.cdm.entity">
        <field name="name">属性ドメイン</field>
        <field name="subject_area_id" ref="subject_area_conceptual"/>
    </record>


    <!-- ========================= -->
    <!-- 論理モデル（Logical Model） -->
    <!-- ========================= -->

    <record id="entity_data_element" model="ems.cdm.entity">
        <field name="name">データ要素</field>
        <field name="subject_area_id" ref="subject_area_logical"/>
    </record>

    <record id="entity_object_class" model="ems.cdm.entity">
        <field name="name">オブジェクトクラス</field>
        <field name="subject_area_id" ref="subject_area_logical"/>
    </record>

    <record id="entity_system" model="ems.cdm.entity">
        <field name="name">システム</field>
        <field name="subject_area_id" ref="subject_area_logical"/>
    </record>

    <record id="entity_value_domain" model="ems.cdm.entity">
        <field name="name">値ドメイン</field>
        <field name="subject_area_id" ref="subject_area_logical"/>
    </record>


    <!-- ========================= -->
    <!-- Odoo実装（Physical Model / Implementation） -->
    <!-- ========================= -->

    <record id="entity_data_item" model="ems.cdm.entity">
        <field name="name">データ項目</field>
        <field name="subject_area_id" ref="subject_area_odoo"/>
    </record>

    <record id="entity_data_model" model="ems.cdm.entity">
        <field name="name">データモデル</field>
        <field name="subject_area_id" ref="subject_area_odoo"/>
    </record>

    <record id="entity_data_domain" model="ems.cdm.entity">
        <field name="name">データドメイン</field>
        <field name="subject_area_id" ref="subject_area_odoo"/>
    </record>

</odoo>
