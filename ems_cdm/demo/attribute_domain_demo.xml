<odoo>

    <!-- 「属性」関連 -->
    <record id="domain_relation_attribute" model="ems.cdm.attribute_domain">
        <field name="name">「属性」関連</field>
        <field name="description">属性への関連を表すドメイン</field>
        <field name="data_type">relation</field>
        <field name="relation_entity_id" ref="entity_attribute"/>
    </record>

    <!-- 「データ要素」継承 -->
    <record id="domain_extended_data_element" model="ems.cdm.attribute_domain">
        <field name="name">「データ要素」継承</field>
        <field name="description">データ要素を継承するドメイン</field>
        <field name="data_type">extended</field>
        <field name="relation_entity_id" ref="entity_data_element"/>
    </record>

    <!-- 「エンティティ」参照 -->
    <record id="domain_reference_entity" model="ems.cdm.attribute_domain">
        <field name="name">「エンティティ」参照</field>
        <field name="description">エンティティへの参照を表すドメイン</field>
        <field name="data_type">reference</field>
        <field name="relation_entity_id" ref="entity_conceptual_entity"/>
    </record>

    <!-- 「エンティティ」関連 -->
    <record id="domain_relation_entity" model="ems.cdm.attribute_domain">
        <field name="name">「エンティティ」関連</field>
        <field name="description">エンティティへの関連を表すドメイン</field>
        <field name="data_type">relation</field>
        <field name="relation_entity_id" ref="entity_conceptual_entity"/>
    </record>

    <!-- 「オブジェクトクラス」関連 -->
    <record id="domain_relation_object_class" model="ems.cdm.attribute_domain">
        <field name="name">「オブジェクトクラス」関連</field>
        <field name="description">オブジェクトクラスへの関連を表すドメイン</field>
        <field name="data_type">relation</field>
        <field name="relation_entity_id" ref="entity_object_class"/>
    </record>

    <!-- レコード名称（文字列系） -->
    <record id="domain_record_name" model="ems.cdm.attribute_domain">
        <field name="name">レコード名称</field>
        <field name="description">レコードの名称を表す文字列ドメイン</field>
        <field name="data_type">string</field>
    </record>

</odoo>
