<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- 属性ドメイン：リストビュー -->
    <record id="view_attribute_domain_list" model="ir.ui.view">
        <field name="name">ems.cdm.attribute_domain.list</field>
        <field name="model">ems.cdm.attribute_domain</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="data_type"/>
                <field name="relation_entity_id"/>
            </list>
        </field>
    </record>

    <!-- 属性ドメイン：フォームビュー -->
    <record id="view_attribute_domain_form" model="ir.ui.view">
        <field name="name">ems.cdm.attribute_domain.form</field>
        <field name="model">ems.cdm.attribute_domain</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="data_type"/>
                        <field name="relation_entity_id"/>
                    </group>

                    <notebook>
                        <page string="関連属性">
                            <field name="attribute_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="entity_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- アクション -->
    <record id="action_attribute_domain" model="ir.actions.act_window">
        <field name="name">属性ドメイン</field>
        <field name="res_model">ems.cdm.attribute_domain</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
