<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- 属性：リストビュー -->
    <record id="view_attribute_list" model="ir.ui.view">
        <field name="name">ems.cdm.attribute.list</field>
        <field name="model">ems.cdm.attribute</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="entity_id"/>
                <field name="domain_id"/>
            </list>
        </field>
    </record>

    <!-- 属性：フォームビュー -->
    <record id="view_attribute_form" model="ir.ui.view">
        <field name="name">ems.cdm.attribute.form</field>
        <field name="model">ems.cdm.attribute</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="entity_id"/>
                        <field name="domain_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- アクション -->
    <record id="action_attribute" model="ir.actions.act_window">
        <field name="name">属性</field>
        <field name="res_model">ems.cdm.attribute</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
