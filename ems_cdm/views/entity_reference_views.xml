<odoo>
    <!-- 一覧ビュー -->
    <record id="view_entity_reference_list" model="ir.ui.view">
        <field name="name">ems.cdm.entity_reference.list</field>
        <field name="model">ems.cdm.entity_reference</field>
        <field name="arch" type="xml">
            <list string="エンティティ参照">
                <field name="source_entity_id"/>
                <field name="target_entity_id"/>
            </list>
        </field>
    </record>

    <!-- フォームビュー -->
    <record id="view_entity_reference_form" model="ir.ui.view">
        <field name="name">ems.cdm.entity_reference.form</field>
        <field name="model">ems.cdm.entity_reference</field>
        <field name="arch" type="xml">
            <form string="エンティティ参照">
                <sheet>
                    <group>
                        <field name="source_entity_id"/>
                        <field name="target_entity_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- アクション -->
    <record id="action_entity_reference" model="ir.actions.act_window">
        <field name="name">エンティティ参照</field>
        <field name="res_model">ems.cdm.entity_reference</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
