<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- フォームビュー -->
    <record id="view_rule_form" model="ir.ui.view">
        <field name="name">ems.cdm.rule.form</field>
        <field name="model">ems.cdm.rule</field>
        <field name="arch" type="xml">
            <form string="ルール">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="entity_id"/>
                    </group>

                    <group string="対象属性">
                        <field name="target_attribute_ids">
                            <list editable="bottom" default_order="sequence">
                                <field name="sequence" widget="handle"/>
                                <field name="attribute_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- リストビュー（Odoo19仕様） -->
    <record id="view_rule_list" model="ir.ui.view">
        <field name="name">ems.cdm.rule.list</field>
        <field name="model">ems.cdm.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="entity_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- アクション -->
    <record id="action_rule" model="ir.actions.act_window">
        <field name="name">ルール</field>
        <field name="res_model">ems.cdm.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
