<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_uml_generator_form" model="ir.ui.view">
        <field name="name">ems.cdm.uml_generator.form</field>
        <field name="model">ems.cdm.uml_generator</field>
        <field name="arch" type="xml">
            <form string="UML Generator">

                <header>
                    <button name="generate_uml"
                            string="UML生成"
                            type="object"
                            class="btn-primary"/>
                    <button name="generate_uml"
                            string="UML（note あり）"
                            type="object"
                            context="{'generate_note': True}"/>
                    <button name="generate_uml"
                            string="UML（note なし）"
                            type="object"
                            context="{'generate_note': False}"/>
                    <button string="閉じる"
                            class="btn-secondary"
                            special="cancel"/>
                </header>
                <footer>
                </footer>

                <sheet>
                    <group>
                        <field name="uml_png_url" invisible="0"/>
                        <field name="uml_png" widget="image"/>
                    </group>

                    <group>
                        <field name="uml_text" nolabel="1"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="action_uml_generator" model="ir.actions.act_window">
        <field name="name">UML 生成</field>
        <field name="res_model">ems.cdm.uml_generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
