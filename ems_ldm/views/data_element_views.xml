<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================= -->
    <!--  リストビュー（Odoo 19）       -->
    <!-- ============================= -->
    <record id="view_data_element_list" model="ir.ui.view">
        <field name="name">ems.ldm.data_element.list</field>
        <field name="model">ems.ldm.data_element</field>
        <field name="arch" type="xml">
            <list string="データ要素">
                <field name="sequence"/>
                <field name="name"/>
                <field name="object_class_id"/>
                <field name="value_domain_id"/>
                <field name="attribute_id"/>
            </list>
        </field>
    </record>

    <!-- ============================= -->
    <!--  フォームビュー（Odoo 19）     -->
    <!-- ============================= -->
    <record id="view_data_element_form" model="ir.ui.view">
        <field name="name">ems.ldm.data_element.form</field>
        <field name="model">ems.ldm.data_element</field>
        <field name="arch" type="xml">
            <form string="データ要素">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="name"/>
                    </group>

                    <group>
                        <field name="object_class_id"/>
                        <field name="value_domain_id"/>
                        <field name="attribute_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================= -->
    <!--  アクション                    -->
    <!-- ============================= -->
    <record id="action_data_element" model="ir.actions.act_window">
        <field name="name">データ要素</field>
        <field name="res_model">ems.ldm.data_element</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
