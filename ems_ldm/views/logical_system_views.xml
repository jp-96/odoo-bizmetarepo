<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================= -->
    <!--  リストビュー（Odoo 19）       -->
    <!-- ============================= -->
    <record id="view_logical_system_list" model="ir.ui.view">
        <field name="name">ems.ldm.logical_system.list</field>
        <field name="model">ems.ldm.logical_system</field>
        <field name="arch" type="xml">
            <list string="システム" editable="bottom" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- ============================= -->
    <!--  フォームビュー（Odoo 19）     -->
    <!-- ============================= -->
    <record id="view_logical_system_form" model="ir.ui.view">
        <field name="name">ems.ldm.logical_system.form</field>
        <field name="model">ems.ldm.logical_system</field>
        <field name="arch" type="xml">
            <form string="システム">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>

                    <notebook>
                        <page string="オブジェクトクラス">
                            <field name="object_class_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================= -->
    <!--  アクション                    -->
    <!-- ============================= -->
    <record id="action_logical_system" model="ir.actions.act_window">
        <field name="name">システム</field>
        <field name="res_model">ems.ldm.logical_system</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
