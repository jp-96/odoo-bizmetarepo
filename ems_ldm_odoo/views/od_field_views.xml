<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================= -->
    <!-- 1. List View (Odoo 19 対応) -->
    <!-- ============================= -->
    <record id="view_field_list" model="ir.ui.view">
        <field name="name">ems.ldm.odoo.field.list</field>
        <field name="model">ems.ldm.odoo.field</field>
        <field name="arch" type="xml">
            <list string="Odoo 項目">
                <field name="name"/>
                <field name="field_name"/>
                <field name="field_domain_id"/>
                <field name="object_class_id"/>
            </list>
        </field>
    </record>

    <!-- ============================= -->
    <!-- 2. Form View -->
    <!-- ============================= -->
    <record id="view_field_form" model="ir.ui.view">
        <field name="name">ems.ldm.odoo.field.form</field>
        <field name="model">ems.ldm.odoo.field</field>
        <field name="arch" type="xml">
            <form string="Odoo 項目">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="field_name"/>
                        <field name="field_domain_id"/>
                        <field name="object_class_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================= -->
    <!-- 3. Action -->
    <!-- ============================= -->
    <record id="action_field" model="ir.actions.act_window">
        <field name="name">Odoo 項目</field>
        <field name="res_model">ems.ldm.odoo.field</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
