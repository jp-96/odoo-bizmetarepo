<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- LDM UML Generator フォームビュー -->
    <record id="view_uml_ldm_generator_form" model="ir.ui.view">
        <field name="name">ems.uml.ldm_generator.form</field>
        <field name="model">ems.uml.ldm_generator</field>
        <field name="arch" type="xml">
            <form string="LDM UML Generator">

                <header>
                    <button name="generate_uml"
                            string="UML生成"
                            type="object"
                            class="btn-primary"/>

                    <!-- CDM と同じ note オプション（互換性のため残す） -->
                    <button name="generate_uml"
                            string="UML（note あり）"
                            type="object"
                            context="{'generate_note': True}"/>

                    <button name="generate_uml"
                            string="UML（note なし）"
                            type="object"
                            context="{'generate_note': False}"/>

                    <button string="閉じる"
                            class="btn-secondary"
                            special="cancel"/>
                </header>

                <sheet>
                    <group>
                        <field name="uml_png_url" invisible="0"/>
                        <field name="uml_png" widget="image"/>
                    </group>

                    <group>
                        <field name="uml_text" nolabel="1"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- LDM UML Generator アクション -->
    <record id="action_ldm_generator" model="ir.actions.act_window">
        <field name="name">LDM UML 生成</field>
        <field name="res_model">ems.uml.ldm_generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
